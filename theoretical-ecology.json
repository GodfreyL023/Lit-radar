  "research_context": "Example profile: a PhD programme at the interface of theoretical ecology and mathematical biology - Modern Coexistence Theory (MCT), biodiversity-ecosystem functioning and stability (BEF/BES), and community dynamics in stochastic environments. Methodological preferences: rigorous derivations (Ito SDEs, Fokker-Planck equations, linear noise approximation, permanence theory, the geometry of structural stability), spatial metacommunity simulations, and empirical tests with temperate/boreal forest-plot data and ForestGEO censuses.",
  "active_projects": [
    {
      "key": "mct-review",
      "label": "MCT review: storage effect, relative nonlinearity and lottery-model derivations",
      "keywords": [
        "storage effect",
        "relative nonlinearity",
        "lottery model",
        "coexistence mechanism partitioning",
        "invasion growth rate",
        "temporal niche"
      ]
    },
    {
